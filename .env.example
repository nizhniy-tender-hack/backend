# Подключение к PostgreSQL (async-драйвер asyncpg).
# Локально без Docker — localhost; внутри docker compose хост подставляется автоматически (сервис `db`).
DATABASE_URL=postgresql+asyncpg://tender:tender@localhost:5432/tender_hack

# Приложение
APP_NAME="Tender Hack Support Backend"
ENVIRONMENT=local
DEBUG=true
API_V1_PREFIX=/api/v1

# CORS: список origin-ов фронтенда через запятую.
# `*` допустим только локально; в проде указывать явный origin, иначе браузер отбросит
# запросы с credentials (см. app/main.py).
CORS_ORIGINS=*

# Пул соединений
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_ECHO=false

# --- Переменные для docker compose (подставляются в docker-compose*.yml) ---
POSTGRES_USER=tender
POSTGRES_PASSWORD=tender
POSTGRES_DB=tender_hack

# --- Только для прода (docker-compose.prod.yml) ---
# POSTGRES_PASSWORD здесь обязателен и должен быть длинным случайным.
DOMAIN=ked-ai.site
# Почта для Let's Encrypt: на неё приходят уведомления об истечении сертификата.
ACME_EMAIL=
