# Подключение к PostgreSQL (async-драйвер asyncpg)
DATABASE_URL=postgresql+asyncpg://tender:tender@localhost:5432/tender_hack

# Приложение
APP_NAME="Tender Hack Support Backend"
ENVIRONMENT=local
DEBUG=true
API_V1_PREFIX=/api/v1

# CORS: список origin-ов фронтенда через запятую, * — разрешить все
CORS_ORIGINS=*

# Пул соединений
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_ECHO=false
